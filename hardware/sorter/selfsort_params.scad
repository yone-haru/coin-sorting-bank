// =============================================================================
// 自作判別部 — 共通寸法（唯一の正）  v2  2026-09-27（シミュレーションで決めた本番の値）
// =============================================================================
// 方式：「立てて転がし、壁の窓から倒して落とす（とりだし君と同じ原理）」で 4 つに大まかに分け、
//       同じレーンに入る 2 金種は「穴センサー」（5円・50円の中心の穴を光が一瞬通る）で分ける。
//
//   レーン        しきい値（窓の高さ）  落ちる硬貨        穴で分ける
//   W1           21.5                  1円 20.0・50円 21.0   穴あり→50円 / なし→1円
//   W2           23.05                 5円 22.0・100円 22.6  穴あり→5円  / なし→100円
//   W3           25.0                  10円 23.5            （穴なしを確認）
//   終端         —                     500円 26.5           （穴なしを確認）
//
// v2 で変えたこと（sim/coin_sim.py の物理シミュレーション、約 3 万回の転がしで決めた。設計メモ.md 第 6 章）
//   ・勾配 6°→10°、壁の傾き 20°→12°：6°/20° では壁との摩擦で硬貨が途中で止まる
//   ・窓の下に縁石 2.5mm：窓が床の面から開いていると、大きい硬貨の下の縁が窓へ滑り込んで落ちる
//   ・溝の手前に板（すき間 4.5・床から 20mm）：跳ねた硬貨が手前へ倒れて外へ出るのを防ぐ
//   ・着地場所の床にフェルト 2mm：跳ねが W1 まで残ると判別が乱れる（なしだと厳しい条件で 83%）
//   ・W3 を 34→40 に延長、板 172→178：一番速くなる 10 円が W3 を飛び越えることがあった
//   ・下流側の縁の面取りをやめた（0）：効果がほとんどなかった
//   ・レーンのセンサーを「溝を縦に貫く光」3 本に変更（P1〜P3）。窓の裏に部品を置くと落ちる硬貨が当たる
//
// 座標（判別レールの印刷姿勢のまま）
//   x = レールに沿う向き（下り）   y = 壁に沿って上向き（床の面が y=0）   z = 壁の法線（硬貨側が +z）
//   壁（板）は z = 0..plate_t。硬貨は z = plate_t の面にもたれ、床の面（y=0）の上を転がる。
//   窓は板を貫通する穴。背の低い硬貨は窓から -z 側（壁の裏）へ倒れて落ちる。
// =============================================================================

// ---- 硬貨 [名前, 直径, 厚み, 穴径] ------------------------------------------
coins = [["1",   20.0, 1.5, 0],
         ["50",  21.0, 1.7, 4.0],
         ["5",   22.0, 1.5, 5.0],
         ["100", 22.6, 1.7, 0],
         ["10",  23.5, 1.5, 0],
         ["500", 26.5, 1.8, 0]];

// ---- 姿勢 ----------------------------------------------------------------------
rail_alpha   = 10;    // 下り勾配 [deg]（9〜11 で判別率がほぼ変わらない）
rail_beta    = 12;    // 壁の後ろへの傾き [deg]（10 だと 93%、12 で 99%、14 で 98%。組立の誤差は ±1 以内に）
test_alpha   = 10;    // 試験台（旧 6）＝ rail_alpha と同じ値にしておく
test_beta    = 12;    // 試験台（旧 20）

// ---- 板と床 -----------------------------------------------------------------
plate_t    = 3.0;     // 壁の厚み
rib_t      = 5.0;     // 床のブロックの厚み（y 方向。床の面より下。フェルトのくぼみを掘るため 2.5→5）
floor_w    = 4.5;     // 床の幅（壁の面から手前の板まで）＝ 溝の幅
plate_y0   = -9.0;    // 板の下端（床の下に帯を残す）
plate_y1   = 33.0;    // 板の上端（500円 26.5 より上に余裕）
plate_len  = 177.5;   // 板の長さ（上流の端の壁 1.5 と合わせて 179。A1 mini の 180 に収まる）
land_len   = 28.0;    // 上流端の着地場所（関門から落ちた硬貨が床に立つ。500円 26.5 が入る長さ）
pad_t      = 0;       // 着地場所の床に貼るフェルトの厚み（床をこの分だけ掘る）。0 = フェルトなし・床は平ら（2026-09-27 決定。フェルトありは 2.0）

// ---- 窓（しきい値）-------------------------------------------------------------
// [名前, 始まり x, 長さ, 高さ（しきい値）]
win_comp   = 0.10;    // 印刷で穴が小さく出る分の補正（窓の高さに足す）。試験で合わせる
windows = [["W1 1円/50円",   60, 30, 21.50],
           ["W2 5円/100円",  94, 32, 23.05],
           ["W3 10円",      130, 38, 25.00]];
curb_h     = 2.5;     // 窓の下の縁石の高さ（窓は y = curb_h から開く）
jamb_bevel = 0;       // 窓の下流側の縁の面取り（0 = 角のまま）

// ---- 溝の手前の板（前板）と関門 ----------------------------------------------------
guard_gap  = 4.5;     // 壁の面から前板の内面まで（＝ floor_w）
guard_t    = 2.5;     // 前板の厚み
guard_y1   = 20.0;    // 前板の上端（床から）
gate_gap   = 2.6;     // 関門のすき間（500円 1.8 は通り、1円 2 枚 3.0 は通らない）
gate_y0    = plate_y1 - 4;    // 関門の下端（29）
gate_top   = plate_y1 + 10;   // 関門の上端（43）

// ---- じょうご（④ 吊り板）：蓋のスリット → 関門 --------------------------------------------
// 10/1 実機で関門の手前で詰まった → 作り直し（v2）。出口を関門と同じ幅にして段をなくし、
// 曲がりは「厚い部屋」の中で回す。形は sim/funnel_2d.py（剛体の板の 2D 到達試験）で決めた。
// 試験の教訓：細い出口を長くすると長い硬貨（500円 26.5）が入れず詰まる。直線は 6mm（関門の深さ 14mm が既に直線）。
//            斜めのすぼまり（約 17°）を細い出口の直前に置くと全金種が詰まる。必ず部屋で回してから入れる。
fun_out_x     = [0, land_len]; // 出口の x（関門と完全に同じ 0〜28。10/1 ユーザー指示：データ上で寸法を完全に合わせる）
fun_out_z     = [3.0, 5.6];    // 出口の z（関門と同じ厚み 2.6。段を作らない）
fun_straight  = 4;             // 出口の直線部分の長さ（関門の上端から上へ）。10/1 試験：6 だと 500円が組立ずれ（+0.4,+0.4,-0.2）で詰まる。4 なら全ずらしで全金種が通る
fun_ch_y      = 68;            // 部屋（回る所）の高さ（レール座標 y）
fun_ch_z      = [3.1, 14];     // 部屋の厚み方向の範囲
fun_in_w      = 29.5;          // 入口の絞り（蓋の真下）の幅
fun_in_t      = 2.8;           // 入口の絞りの厚み。1円 2 枚（3.0）も 500円＋1円（3.3）も入らない＝一枚ずつ
fun_in_depth  = 2.5;           // 絞りの位置（蓋の裏から下へ）
fun_lip       = 1.5;           // スリット直下のまっすぐな部分（段を作らない）

// ---- 穴センサー（2 本・冗長）--------------------------------------------------
hole_beam_y  = 10.75;           // ビームの高さ（50円の中心 10.5 と 5円の中心 11.0 の間）
hole_beam_x  = [35, 49];        // 2 本のビームの位置（着地場所のすぐ下流）
aperture_d   = 1.5;             // ビームを絞る穴
elem_d       = 5.7;             // 5mm 砲弾型の LED / フォトトランジスタの穴（5.4 は印刷で縮んで入らなかった）
elem_len     = 8.6;             // 素子の胴の長さ
bridge_len   = 28;
bridge_x     = [land_len, land_len + bridge_len];  // LED を載せる橋（硬貨の手前をまたぐ）
bridge_gap   = 4.5;             // 硬貨の面から橋の下面まで（＝ guard_gap）
bridge_t     = 3.0;
bridge_y1    = 32.0;            // 橋の上側の支え（500円より上）

// ---- 通過センサー（レーン）：溝を縦（y）に貫く光。LED は床の下、受光は硬貨の上 -----------
pass_beam_x  = [98, 134, 173.5];  // P1（W1 の後ろ）・P2（W2 の後ろ）・P3（W3 の後ろ＝500円だけ通る）
pass_beam_z  = plate_t + 0.8;   // 壁の面から 0.8mm（寄りかかった硬貨の厚みの中）
pass_ap_d    = 1.0;             // 絞り穴
pass_top_y   = 29.5;            // 受光側の絞り穴の下端（500円の上 26.5 から 3mm）

// ---- 素子の押さえキャップ（⑤・2026-10-07）--------------------------------------------
// 素子のつばを穴の入口の面へ押し付けて、抜け・傾きを止める。ねじは使わない（かぶせるだけ）。
// 10/7 試し刷り：⑤-1〜⑤-3 は少し大きかった → すき間を 0 にした（ユーザー指示「データ上で完璧に」。印刷の誤差は見込まない）。
//                ⑤-4 はちょうどよかったので、cap_clr / cap_pocket_d はそのまま ⑤-4 だけに使う
//                10/7 2 回目：⑤-1 はちょうど、⑤-2・⑤-3 はまだ少しゆるい → ⑤-2・⑤-3 だけ片側 0.1 きつくした（prx_clr / cup_clr）
fit_clr      = 0;               // ⑤-1（と ⑤-2 のつばを押す面）のすき間（片側）。データ上でぴったり。⑤-1 はこれでよかった
prx_clr      = -0.1;            // ⑤-2（通過 受光）の横の壁とブロックのすき間（片側）。マイナス＝ブロックより 0.1 細い（10/7 に 0 → -0.1）
flange_d     = 5.8;             // 素子のつばの直径。⑤-1〜⑤-3 のつばのくぼみはこの寸法のまま
cap_clr      = 0.15;            // ⑤-4（③ の裏ふた）と ③ とのすき間（片側）。⑤-4 はこれでよかった（10/7）
cap_wall     = 1.2;             // 横の壁の厚み
cap_back     = 1.0;             // つばの後ろを押す壁の厚み
flange_t     = 1.0;             // 素子のつばの厚み。ノギスで測って違えば直す
cap_pocket_d = 6.3;             // ⑤-4 のつばのくぼみ（⑤-4 はこれでよかった）
cap_lead_w   = 3.6;             // 足を出す溝の幅（足 2 本の間隔 2.54 ＋ 足の太さ。素子がどの向きに回っていても入る）
cap_ear_gap  = 0;               // 通過 LED のキャップの耳と、下の溝の返しとのすき間（10/7 に 0.1 → 0）
cup_clr      = -0.1;            // 橋の塔（φ9.7）にかぶせる筒のすき間（片側。10/7 に 0.2 → 0 → -0.1。マイナス＝内径 φ9.5。C 字なので少し開いてはまる）
cup_depth    = 5;               // 〃 塔にかぶさる深さ
cap_peg_d    = 6.8;             // ③ の裏ふたの突起。③ のねじの座ぐり φ7（刷ると 6.7〜6.8）に押し込んで留める。抜けやすければ 7.0、入らなければ 6.6
cap_peg_len  = 4;

// ---- 取付 --------------------------------------------------------------------
m3_d         = 3.4;
m3_tap       = 2.6;             // M3 タッピングの下穴
pin_d        = 3.0;             // 裏に付ける受光素子ホルダーの位置決めピン穴
pin_xy       = [[30, -5.8], [54, -5.8], [42, 30.0]];
mount_y      = -5.8;            // （旧版の試験台・ホルダー用）
mount_x      = [6, 92, 166];

$fn = 48;
