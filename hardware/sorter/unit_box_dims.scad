// =============================================================================
// ユニット箱（A1 mini 版）の寸法の正
// =============================================================================
// 設計書：docs/superpowers/specs/2026-10-08-unit-box-design.md
// 値は「蓋の座標」（蓋の左奥の角が原点・X 右・Y 手前）で書く。
// 形は実物座標（Y = −蓋の Y・Z 上・先方の蓋の裏 = 0）で作るので、L2P() で直してから使う。
// chassis_dims.scad の名前とぶつからないよう、ここの変数は ub_ で始める。
// =============================================================================
include <../chassis_dims.scad>

function L2P(p) = [p[0], -p[1], len(p) > 2 ? p[2] : 0];

// --- 天板 ---------------------------------------------------------------------
ub_plate_t   = 5.0;                  // 天板の厚み（Z 0〜−5）
ub_x         = [128.5, 306.5];       // 天板の左右（幅 178）
ub_seam_y    = 183.0;                // 天板A と B の継ぎ目
ub_a_y       = [5.0, ub_seam_y];     // 天板A（奥）
ub_b_y       = [ub_seam_y, 340.0];   // 天板B（手前）
ub_top_keep  = 0.5;                  // 下からの止まり穴は上面から 0.5〜1mm 残す（蓋に当たる面を平らに保つ）

// --- ボス（M4 タッピング） -----------------------------------------------------
ub_boss_d    = 9.0;
ub_boss_h    = 8.0;                  // 天板の下面からの高さ（Z −5〜−13）
ub_m4_pilot  = 3.3;
ub_pilot_top = 1.0;                  // 下穴は上面から 1mm 手前で止める

// ④吊り板のボス（蓋_製作仕様書 v2.1 と同じ位置）
ub_hang_boss = [for (p = boss_xy(cradle_w, cradle_d)) [cradle_ox + p[0], cradle_oy + p[1]]];

// 基板室（90° 回して置く）のつばの穴。load_bay() の置き方と組で決まる（テストで照合する）
ub_bay_place = [298, -315, -71];     // 実物座標の平行移動（回転は Z まわり 90°）
ub_bay_boss  = [[133, 190], [302, 190], [133, 319], [302, 319]];

// --- スリットのすり鉢 ------------------------------------------------------------
ub_slot_c    = slot_c;               // (175, 56)
ub_slot_bot  = [40.6, 6.6];          // 下面（④のじょうごの入口に合わせる）
ub_slot_top  = [48.0, 14.0];         // 上面（先方のスリットが ±3mm ずれても受ける）

// --- スピーカー（LSE77-20R・上向き） --------------------------------------------
ub_spk_c       = [220, 140];
ub_spk_sq      = 78.0;
ub_spk_depth   = 38.0;               // 奥行き（35＋余裕）
ub_spk_boss_d  = 8.0;
ub_spk_boss_h  = 3.0;                // Z −5〜−8。スピーカーの前面は Z −8
ub_spk_pilot   = 2.6;                // M3 タッピング
ub_spk_hole_half = 29.7;             // ねじ穴のピッチの半分。メーカー図面 SPL P103718-R2：4-φ4.3・PCD84・穴間 59±0.5（84/√2 = 59.40）。10/8 確定
ub_snd_d     = 4.0;                  // 音抜きの小穴
ub_snd_pitch = 7.0;
ub_snd_r     = 34.0;                 // 小穴の中心はこの半径の中
ub_snd = [for (i = [-6:6], j = [-6:6])
            let(p = [i * ub_snd_pitch + (abs(j) % 2) * ub_snd_pitch / 2,
                     j * ub_snd_pitch * sin(60)])
            if (norm(p) <= ub_snd_r) ub_spk_c + p];

// --- 先方の蓋へ（M4 ×6・下面のくぼみに六角ナット） -------------------------------
ub_lid_m4   = [[150, 11], [295, 11], [135, 176], [300, 176], [190, 332], [245, 332]];
ub_m4_hole  = m4_hole;               // 4.5
ub_nut_af   = 7.1;                   // M4 ナットの二面幅 7 ＋ 0.1（圧入。くぼみは下向きなので、ゆるいと落ちる。きつければねじで引き込む）
ub_nut_top  = -1.6;                  // くぼみの天井（Z）。下面 −5 から 3.4 の深さ
ub_screw_tip = -15.0;                // ねじの先が来る一番下（Z）

// --- 継ぎ板（M3 タッピング ×4 ずつ） ---------------------------------------------
ub_splice_t  = 4.0;                  // Z −5〜−9
ub_splice    = [[141, 165, 176, 201], [264, 165, 294, 201]];   // [x0, y0, x1, y1]
ub_splice_screw = [[150, 170], [150, 196], [167, 170], [167, 196],
                   [272, 170], [272, 196], [286, 170], [286, 196]];
ub_m3_clear  = 3.4;
ub_m3_pilot  = 2.6;

// --- 脚（同じ形 ×4） ------------------------------------------------------------
ub_leg_sq    = 14.0;                 // 柱の断面
ub_leg_h     = 135.0;                // 天板の下面から（脚の下端は Z −140）
ub_leg_pad   = [14.0, 40.0, 4.0];    // 天板に当てる座
ub_leg_gus_t = 2.5;                  // 両わきの三角の補強の厚み
ub_leg_gus   = [[14, -4], [40, -4], [14, -30]];   // 補強の三角（脚のローカル y, z）
ub_leg_hole_s = [15, 26];            // 柱の中心から座の向きへ、ねじ穴までの距離
ub_legs = [[[136, 107], [0, 1]], [[299, 107], [0, 1]],
           [[136, 332], [1, 0]], [[299, 332], [-1, 0]]];   // [柱の中心, 座の向き]（蓋の座標）
ub_leg_holes = [for (l = ub_legs) for (s = ub_leg_hole_s) l[0] + s * l[1]];
