// =============================================================================
// 制御ユニット筐体 — 共通寸法（唯一の正）
// =============================================================================
// 筐体_ソータ架台.scad と 筐体_基板室.scad の両方がここを include する。
// 数値を直すときはこのファイルだけ直して、両方を出力し直すこと。
//
// 蓋の座標の取り方（蓋を上から見た図。蓋の「奥の左角」が原点）
//   X = 右向き（0〜350）  Y = 手前向き（0〜350）
//
//   ┌────────────────────────────────────────┐ 奥（Y=0）
//   │          ○電源φ8 (100, 30)             │
//   │  ┌──────────────┐    ┌──────────────┐  │
//   │  │   基板室      │    │ ソータ架台    │  │
//   │  │               │    │  ▭投入スリット│  │
//   │  └──────────────┘    └──────────────┘  │
//   │  ┌────┐                                │
//   │  │音抜き│       ガスパトマン            │
//   │  └────┘                                │
//   └────────────────────────────────────────┘ 手前（Y=350）
//
// ★ 蓋の上のボスの位置は、この下の echo が出す数値が正です。
//    クライアント提出書類には echo の値を書くこと（手で書き写して食い違わせない）。
// =============================================================================


// ===== ① 現物を実測して直す値 ================================================
// ★ ここだけノギスで測って直せば、両方の部品が正しい寸法で出力されます。
//    測り方は 筐体_README.md の「実測する6か所」を見てください。

// ★ 2026-09-25 に判別部の構造を把握し直した（3Dプリント/判別部_構造メモ.md）。座標の取り方：
//   ・判別部は **A 板（刻印 A・幅 100・本体側）を手前（−Y）**、B 板（幅 92・A にはめ込む）を奥にして立てる
//   ・「左端」は A 板の左端。**硬貨の入口はこの左端寄り**（A を手前にすると入口が左に来る。
//     B を手前にすると右端になり、蓋のスリット位置と合わなくなるので向きを固定した）
//   ・底面は A 板の下辺。B のピンは A にはまるので床に穴は不要
//   ・A 板の上辺中央に U 溝のタブ（板と同じ面内・上に tab_h 出る）。**ここにねじを通して架台に留める**
// ★ 2026-09-25（午後）：手元の写真・スキャン全部から読み直した（履歴.md 同日・「写真全部から寸法」）。
//   定規つき平面写真（A: IMG_20260925_114406 6.0px/mm、B: IMG_20260907_234631 6.0px/mm）を主に、
//   窓の相対位置はスキャン（toridashi_windows.json）、B の据わりは組んだ写真（IMG_20260925_114504）から。
//   誤差の見込みを各行に書く。架台側は sens_slack / inlet_clear / 長穴で吸収する
unit_w      = 102.0;  // 判別部の幅＝A 板の本体幅（硬貨が転がる方向）… 平面写真 101.2〜102.3（±1）。入口側の下寄りに 3.6 の張り出しあり
unit_d      = 33.6;   // 判別部の奥行（2枚の板を重ねた厚み）      … スキャン実測
unit_h      = 61.0;   // 判別部の高さ＝A 板の高さ（タブを含まない） … 平面写真 60.5〜61.2（±0.7）
unitB_top   = 61.0;   // 組んだ状態での B 板の上辺の高さ（A の底から）… 組んだ写真で A と B の上辺はほぼ同じ高さ（±1.5）。
                      //   B 本体 43.5〜45 高、下辺は A の底から約 16 上。下角のピンで A の受け穴に掛かる
inlet_x     = 15.0;   // 硬貨の入口の中心（A 板の左端から）        … ユーザー実測 端から 30 ＋ 上辺ビュー写真（口 1〜28）→ 中心 14.5〜15（±1）
inlet_len   = 30.0;   // 入口の長さ（硬貨が転がる方向）           … ユーザー実測 30（上辺ビューでは 27。筒は 30 のまま、下端を板の 1mm 上で止める）
inlet_gap   =  4.0;   // 入口の溝の幅（板と板のあいだ方向）        … ユーザー実測 4
inlet_y     =  3.0;   // B 板の外側の面から溝の中心まで            … 上辺ビュー写真：B 面→箱の壁 4.8 ＝ B の壁 0.8 ＋ 溝 4 → 中心 2.8〜3.2（±0.5）
// ★ タブ（2026-09-25 夕・ユーザー指摘で確定）：根元で 90° **外側に折れて水平**になり、ねじは**上向き**に入る。
//   おもちゃでは頭部のカップに上向きにねじ止めしていた。A のタブは A 面の外（−Y）へ、B のタブは B 面の外（+Y）へ折れる。
//   架台では A のタブを折って天板裏のボスへ上向きにねじ 1 本。B のタブは立てたまま（折ると B のセンサー板の LED の耳に
//   当たる恐れがある）、B は天板からの押さえ柱で止める。B のタブが邪魔なら切ってよい（機能は無い）
tab_x       = 56.0;   // A 板のタブの中心（A 板の左端から）        … 平面写真 55.8〜56.4（±0.7）。幅 10.4
tabA_len    = 13.0;   // A のタブを水平に折ったときの長さ（A 面から外へ）… 接写 12〜13
tab_t       =  2.0;   // タブの厚み                               … 【仮】
tabA_slot   = [4.0, 13.0];      // 折ったタブの U 溝が A 面から何 mm の範囲にあるか（根元側の端〜先端。先端は開いている）
tabB_x      = 55.0;   // B 板のタブの中心（A 板の左端から。B 本体が A の 2 内側）… ±2
tabB_h      = 10.0;   // B のタブを立てたときの高さ（B の上辺から）  … スキャン 57.15 − 本体 47 ≈ 10
// 2026-09-11：センサー板を窓の実測座標から作り直して大きくなった（素子の耳まで含む長方形。
//   B 90.4×58.4 / A 99.7×59.6mm）。
// 2026-09-24：x0 の 2 つは、スキャン（toridashi_windows.json）の板の外形に対する
//   センサー板の位置から推定した値に置き換えた（板の外形は縁がぼけていて ±2mm）。
//   その ±2mm は下の sens_slack（ポケットの遊び）で吸収し、板は窓に合わせて判別部に
//   両面テープ／ホットボンドで直に貼る。リブと結束バンドは押さえだけ。
//   zc の 2 つはスキャンから決められない（判別部が何で床に立つかで変わる。B 側の板は
//   スキャン上、板の本体より 9mm ほど下＝ピンの先まで伸びる）。出力したセンサー板を
//   窓に合わせて当て、板の下辺の高さを定規で読んで直すこと（筐体_README.md 第2章）
// 2026-09-25（午後）：センサー板の位置は「窓の位置（写真で A の底・入口端から実測）」＋「板の形（sensor_layout）」から計算。
//   A：窓は 100円 X≈23 Z≈28.5 / 10円 X≈47 Z≈22 / 500円 X≈75 Z≈19（A の底・入口端から）。
//      窓が板の下寄りにあるので、**A のセンサー板の下端（PT の耳）は A の底より約 6.4mm 下に出る**
//   B：B の下辺は A の底の約 16 上。窓は 1円 Z≈39 / 50円 Z≈34 / 5円 Z≈28。板の下端は A の底の約 4 上
//   どちらも ±2。sens_slack で吸収し、板は窓に合わせてテープで貼る
// 2026-09-25 夜：開口を左右 2.5 ずつ広げ（EXTRA_LR）、帯・柱を太くした（WALL 5・PAD_W 8）ので板が長くなり、左端は外へ
sensA_x0    = -6.3;   // A側センサー板の左端（A 板の左端から）    … 100円の窓中心 23 − 板の入口側端から窓まで 29.3
sensB_x0    =  7.6;   // B側センサー板の左端（〃）                … 2026-09-26：入口側の柱なし（NO_PAD）・開口は元のまま → 1円の窓中心 26.4 − 18.8
sensA_zc    = 23.7;   // A側センサー板の中心の高さ（判別部の底から）… 板の下端 −6.7 ＋ 30.4
sensB_zc    = 33.2;   // B側センサー板の中心の高さ（〃）          … 板の下端 +3.3 ＋ 29.9


// ===== ② センサー板（sensor_layout.scad から自動で取る） =====================
// 2026-09-11：窓の実測座標から作り直したので、手で書き写さず生成データを読む。
//   B_size / A_size は素子の耳まで含めた外接矩形（センサー板は長方形）
include <sensor_layout.scad>        // gen_型紙.py が自動生成（ASCII 名）
sensB       = [B_size[0], B_size[1], L_thick];   // B側（1・50・5円）
sensA       = [A_size[0], A_size[1], L_thick];   // A側（100・10・500円）
sens_t      = L_thick;              // 板の厚み
sens_lead   = 4.0;                  // 板の外側にリード線を通すすきま（2026-09-25：板を 7→9 厚にした分 6→4。奥行＝蓋のボス位置を変えないため）
sens_hole_in = 4.0;                 // 板の固定穴が端から何mmか（センサー板.scad の end_pad-3）


// ===== ③ 基板 ===============================================================
pcb        = [95.0, 72.0, 1.6];     // 制御基板（秋月 103054 Bタイプ）
pcb_holes  = [88.9, 66.0];          // その取付穴のピッチ
amp        = [47.0, 83.0, 1.6];     // TDA2030 アンプキット（秋月 112338）
amp_holes  = [41.0, 77.0];          // キットの取付穴ピッチ（公式マニュアル ae-tda2030.pdf の
                                    // 基板外形図：83×47、穴は四隅とも各辺から 3mm・φ3.2
                                    // → 77 × 41。2026-09-20 に確定）
amp_heat_h = 30.0;                  // 放熱器の高さ（この分の空間を空ける）
standoff_h =  6.0;                  // 基板を床から浮かせる高さ
vr_from    = [12.0, 10.0];          // アンプ基板の角から VR1 まで【要実測・仮】


// ===== ④ 設計値（変えてよい） ================================================
wall       = 3.0;     // 壁の厚み
floorT     = 3.0;     // 床の厚み
flange     = 8.0;     // 蓋に留めるつばの幅
fit        = 0.4;     // はめあいのすきま（片側）
m4_hole    = 4.5;     // M4 のバカ穴
m4_slot    = 3.0;     // つばの穴を長穴にする量（位置の逃げ）
m3_tap     = 2.6;     // M3 タッピングの下穴
vr_hole    = 6.0;     // 音量調整用のドライバー穴
hopper_h   = 40.0;    // じょうごの高さ
// 2026-09-25：架台の外寸と入口の位置は **蓋の図面（送信済み）に合わせて固定**し、判別部の左右の
//   張り出し（left_ext / right_ext）はそこから逆算する。判別部の幅が 92→100 に変わっても蓋は変えない
cradle_in_w_fixed = 121.0;   // 架台の内寸（幅）。旧設計 92.2+0.8+20+8 の値。ボス位置がこれで決まっている
inlet_lx_fixed    = 35.4;    // 入口（＝蓋のスリット）の架台の中での X。旧設計 3+20+0.4+12 の値
gate_gap   =  2.6;    // 硬貨を1枚ずつにする関門のすきま（500円 1.85 は通り、1円2枚 3.0 は通らない）
gate_len   = 30.0;    // 〃 の長さ
sens_slack =  3.0;    // センサー板ポケットの遊び（左右・下、片側）。sensX_x0 / zc の誤差を吸収する。
                      // 板の位置は判別部に貼って決めるので、リブは押さえだけ（2026-09-24）。
                      // 出力した板で位置を実測したら 0.5 まで減らしてよい
tab_clear  =  1.5;    // 立てた B のタブの上と天板の下面のすき間
tab_screw_hole = 2.6; // A のタブの溝に通すねじの下穴（M3 タッピング。おもちゃの M2.6 を使うなら 2.2）
tab_slot_x = 1.5;     // ねじ穴を左右（X）に長穴にする量（片側）。tab_x と判別部の X 位置の誤差の逃げ
boss_d     =  9.0;    // 天板裏のねじボスの径
hold_gap   =  1.5;    // B の押さえ柱の下端と B の上辺のすき間（B の高さの誤差 ±1.5 の逃げ）
inlet_clear=  1.5;    // 天板の入口穴を、実測した入口より左右に広げる量（片側）。定規測定の誤差の逃げ
inlet_clear_y = 0.6;  // 〃 前後（板と板のあいだ方向）に広げる量（合計）
$fn        = 48;


// ===== ⑤ 計算値（触らない） ==================================================
cradle_in_w  = cradle_in_w_fixed;                      // 架台の内寸（幅）。蓋に合わせて固定
left_ext     = 10.0;                                   // 判別部の左の張り出し（左右ほぼ均等に振る）
right_ext    = cradle_in_w - unit_w - 2 * fit - left_ext; // 右の張り出し（残り）
// じょうごは「口＝蓋のスリットの真下（固定）」から「関門＝判別部の入口の真上」へ斜めにつなぐ。
// 入口が判別部の中央になくても（B 面寄り）、蓋の図面は変えずに済む
gate_lx      = wall + left_ext + fit + inlet_x;        // 関門・筒の X（判別部の入口の真上）
gate_ly      = wall + sens_t + sens_lead + unit_d - inlet_y;   // 〃 Y（B 面の内側 inlet_y）
cradle_in_d  = unit_d + 2 * (sens_t + sens_lead);      // 〃（奥行）
cradle_w     = cradle_in_w + 2 * wall;
cradle_d     = cradle_in_d + 2 * wall;
unit_top     = floorT + unit_h;                        // 判別部（A 板）の上辺の高さ
top_z        = floorT + unitB_top + tabB_h + tab_clear; // 天板の下面（立てた B のタブの上に tab_clear のすき間）
boss_z0      = unit_top + tab_t + 0.3;                 // A のタブ用ボスの下面（折ったタブの上面のすぐ上）
boss_h       = top_z - boss_z0;                        // ボスの高さ
tabA_screw_y = (tabA_slot[0] + tabA_slot[1]) / 2;      // ねじの Y（A 面から外へ。溝の中央）
cradle_h     = top_z + wall + hopper_h;

bay_in       = [115.0, 155.0, 55.0];                   // 基板室の内寸（アンプは90度回して置く）
bay_w        = bay_in[0] + 2 * wall;
bay_d        = bay_in[1] + 2 * wall;
bay_h        = bay_in[2] + floorT;

// 入口（＝蓋のスリット）の、架台の中での位置
inlet_lx     = inlet_lx_fixed;                         // じょうごの口の X（蓋のスリットの真下。蓋の図面と結びついている）
inlet_ly     = cradle_d / 2;                           // 〃 Y

// ===== ⑥ 蓋の上での配置 ======================================================
lid          = [350.0, 350.0];       // 蓋の外形
lid_t        = 15.0;                 // 蓋の厚み
recess       = [340.0, 340.0];       // 箱の内側にはまる落とし込み
slot_c       = [175.0, 56.0];        // 蓋の投入スリットの中心（ここを基準に全部決まる）
                                     // 2026-09-08：クライアント要望でできるだけ奥へ寄せた
                                     // （フィギュアの置き場所を広げるため）
slot_size    = [40.0, 6.0];          // 蓋側は大きめ。1枚ずつにする関門は架台の中にある
spk_c        = [50.0, 297.0];        // スピーカーの音抜きの中心（同上・手前の左角へ寄せた）
spk_d        = 76.0;                 // 〃 の範囲の直径
pwr_c        = [100.0, 30.0];        // 電源ジャックの穴の中心
pwr_d        = 8.0;
fig_min_y    =  75.0;                // フィギュアはこれより手前に置いてもらう（130→75 に緩和）

cradle_ox    = slot_c[0] - inlet_lx; // 架台の左手前角（local 0,0）が蓋のどこに来るか
cradle_oy    = slot_c[1] - inlet_ly;

bay_ox       = 116.0;                // 基板室の位置（架台の手前。スピーカーとも重ならないこと）
bay_oy       = 148.0;

// つばのボス穴（部品の中での位置）
function boss_xy(w, d) = [[-flange/2, -flange/2], [w + flange/2, -flange/2],
                          [-flange/2, d + flange/2], [w + flange/2, d + flange/2]];

echo(str("=== 蓋に立てる M4 ボスの位置（蓋の奥の左角が原点・mm）==="));
for (p = boss_xy(cradle_w, cradle_d))
    echo(str("  ソータ架台: (", cradle_ox + p[0], ", ", cradle_oy + p[1], ")"));
for (p = boss_xy(bay_w, bay_d))
    echo(str("  基板室    : (", bay_ox + p[0], ", ", bay_oy + p[1], ")"));
echo(str("=== 外形 ==="));
echo(str("  ソータ架台 ", cradle_w + 2*flange, " x ", cradle_d + 2*flange,
         " x ", cradle_h, " mm（つば込み）"));
echo(str("  基板室     ", bay_w + 2*flange, " x ", bay_d + 2*flange,
         " x ", bay_h, " mm（つば込み）"));
echo(str("  蓋のスリット ", slot_size[0], " x ", slot_size[1],
         " mm・中心 (", slot_c[0], ", ", slot_c[1], ")"));

// ---- 図面生成用の機械可読な出力（gen_蓋レイアウト.py が読む）----------------
echo(str("DATA lid ", lid[0], " ", lid[1], " ", lid_t));
echo(str("DATA recess ", recess[0], " ", recess[1]));
echo(str("DATA slot ", slot_c[0], " ", slot_c[1], " ", slot_size[0], " ", slot_size[1]));
echo(str("DATA spk ", spk_c[0], " ", spk_c[1], " ", spk_d));
echo(str("DATA pwr ", pwr_c[0], " ", pwr_c[1], " ", pwr_d));
echo(str("DATA fig ", fig_min_y));
echo(str("DATA cradle ", cradle_ox, " ", cradle_oy, " ", cradle_w, " ", cradle_d, " ", cradle_h));
echo(str("DATA bay ", bay_ox, " ", bay_oy, " ", bay_w, " ", bay_d, " ", bay_h));
echo(str("DATA flange ", flange, " ", m4_hole));
for (p = boss_xy(cradle_w, cradle_d))
    echo(str("DATA boss cradle ", cradle_ox + p[0], " ", cradle_oy + p[1]));
for (p = boss_xy(bay_w, bay_d))
    echo(str("DATA boss bay ", bay_ox + p[0], " ", bay_oy + p[1]));

// 硬貨の直径（参考）
// 1円20.0 / 50円21.0 / 5円22.0 / 100円22.6 / 10円23.5 / 500円26.5
